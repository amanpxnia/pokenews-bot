# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Right-click the news channel in Discord -> Copy Channel ID (needs Developer Mode on)
CHANNEL_ID=123456789012345678

# News: 1 story per slot, at these local hours (0-23). Default = 8 a day, every 3 hours
NEWS_TIMES=1,4,7,10,13,16,19,22

# Grail reveals from the Card Outpost showroom: channel name (empty = off) and local hours, 1 per slot
CHASE_CHANNEL=legendary-pulls
GRAIL_TIMES=0,3,6,9,12,15,18,21

# Grail reveals: lowest card value to post, in dollars
GRAIL_MIN_PRICE=1500
