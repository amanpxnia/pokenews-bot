# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Right-click the channel in Discord -> Copy Channel ID (needs Developer Mode on)
CHANNEL_ID=123456789012345678

# How often to check feeds, in minutes
POLL_MINUTES=10

# On the very first run, how many of the newest items per feed to post
# (the rest are marked as already seen so the channel doesn't get flooded)
FIRST_RUN_POSTS_PER_FEED=1

# Max new items to post per feed per check (keeps busy feeds like Reddit from spamming)
MAX_POSTS_PER_FEED=5

# Up to 5 emoji added to every post. Default = Pikachu ⚡, Charmander 🔥, Squirtle 💧, Bulbasaur 🌿, Shiny ✨ (comma-separated; empty = none)
REACTIONS=⚡,🔥,💧,🌿,✨

# Chase cards from the Card Outpost showroom. Channel name (empty = off) and local hours to post (0-23, comma-separated)
CHASE_CHANNEL=legendary-pulls
CHASE_TIMES=9,13,17,21

# Grail posts: lowest card value to post, in dollars
GRAIL_MIN_PRICE=1500
